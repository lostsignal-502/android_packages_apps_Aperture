<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Aperture" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="dialogCornerRadius">28dp</item>
        <item name="enableEdgeToEdge">true</item>
    </style>

    <!-- Main activity theme. -->
    <style name="Theme.Aperture.Camera" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="O_MR1">
            shortEdges
        </item>
        <item name="enableEdgeToEdge">true</item>
    </style>

    <!-- M3E: Secondary bar base style -->
    <style name="Theme.Aperture.Camera.SecondaryBarButton">
        <item name="tint">@color/secondary_bar_button_icon</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="drawableTint">@color/secondary_bar_button_icon</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/secondary_bar_button_icon</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- M3E: Secondary top bar icons -->
    <style name="Theme.Aperture.Camera.SecondaryTopBarButton" parent="Theme.Aperture.Camera.SecondaryBarButton">
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:hyphenationFrequency">normal</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/top_bar_button_background</item>
        <item name="android:stateListAnimator">@animator/squish</item>
    </style>

    <!-- M3E: Secondary bottom bar icons -->
    <style name="Theme.Aperture.Camera.SecondaryBottomBarButton" parent="Theme.Aperture.Camera.SecondaryBarButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:stateListAnimator">@animator/squish</item>
    </style>

    <!-- M3E: Island chip image view -->
    <style name="Theme.Aperture.Camera.Island.ImageView" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:paddingHorizontal">2dp</item>
    </style>
</resources>
